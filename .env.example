# ─────────────────────────────────────────────────────────────
#  Aisty Signal: optional configuration
#
#  You DON'T need this file. Run `npm start`, open the dashboard,
#  create your password and connect Google Workspace or Microsoft 365
#  from the Connections tab.
#
#  Use .env for server settings, or for headless/Docker installs
#  where you'd rather not use the UI. Anything saved in the UI
#  takes precedence over the connection values below.
# ─────────────────────────────────────────────────────────────

# Server
HOST=127.0.0.1
PORT=3000
# Demo mode: fictional acme.com data, no credentials needed
SIGNAL_DEMO=false

# Encrypts credentials saved from the UI. If unset, a key is generated in data/secret.key.
# Set it (any long random string) to keep the key separate from the data folder.
SIGNAL_ENCRYPTION_KEY=

# Optional: set the admin password here instead of in the UI (disables changing it in the UI)
SIGNAL_ADMIN_PASSWORD=

# Defaults for scan settings (editable in the UI)
SCAN_LOOKBACK_DAYS=365
SCAN_MAX_MESSAGES_PER_USER=500
SCAN_CONCURRENCY=5
SIGNAL_STORE_SUBJECTS=true

# ── Optional: connect without the UI ──────────────────────────
# Google Workspace
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_ADMIN_EMAIL=
GOOGLE_CUSTOMER_ID=my_customer
GOOGLE_SCAN_MAIL=true

# Microsoft 365
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SCAN_MAIL=true
